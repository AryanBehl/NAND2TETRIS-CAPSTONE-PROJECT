CHIP CPU {
    IN inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aIn);
    Or(a=instruction[15], b=notC, out=loadA);
    Not(in=instruction[15], out=notC);
    Or(a=notC, b=instruction[5], out=loadA);

    ARegister(in=aIn, load=loadA, out=aOut, out[0..14]=addressM);
    DRegister(in=aluOut, load=dLoad, out=dOut);

    And(a=instruction[15], b=instruction[4], out=dLoad);
    Mux16(a=aOut, b=inM, sel=instruction[12], out=y);

    ALU(x=dOut, y=y,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9], ny=instruction[8],
        f=instruction[7], no=instruction[6],
        out=aluOut, zr=zr, ng=ng);

    And(a=instruction[15], b=instruction[3], out=writeM);
    And16(a=aluOut, b=true, out=outM);

    Not(in=ng, out=positive1);
    Not(in=zr, out=positive2);
    And(a=positive1, b=positive2, out=positive);

    And(a=instruction[0], b=positive, out=jgt);
    And(a=instruction[1], b=zr, out=jeq);
    And(a=instruction[2], b=ng, out=jlt);
    Or(a=jgt, b=jeq, out=j1);
    Or(a=j1, b=jlt, out=jump);

    PC(in=aOut, load=jump, inc=true, reset=reset, out[0..14]=pc);
}
