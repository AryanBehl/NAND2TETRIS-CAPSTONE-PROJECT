CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    Not(in=address[14], out=not14);
    Not(in=address[13], out=not13);

    And(a=load, b=not14, out=loadRAM);
    And(a=address[14], b=not13, out=screenSelect);
    And(a=load, b=screenSelect, out=loadScreen);

    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=keyboardOut);

    Mux16(a=ramOut, b=screenOut, sel=address[14], out=memoryOut);

    And(a=address[14], b=address[13], out=keyboardSelect);
    Mux16(a=memoryOut, b=keyboardOut, sel=keyboardSelect, out=out);
}
